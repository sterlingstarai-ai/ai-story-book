<?xml version="1.0" encoding="utf-8"?>
<!--
  M1(2026-08-17 보안감사): X-User-Key 는 이 앱의 유일한 자격증명이다.
  기기 이전(device-transfer)·클라우드 백업(cloud-backup) 어느 쪽으로도 자격증명 저장소가
  빠져나가지 않도록 전부 제외한다. Android 12+ 는 이 파일을, 그 이하는
  allowBackup="false" 가 담당한다(두 경로 모두 닫아야 한다).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
