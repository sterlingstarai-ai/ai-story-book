# ========================================
# AI Story Book API - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!
# ========================================

# ====================
# App Configuration
# ====================
APP_NAME="AI Story Book API"
APP_VERSION="1.0.0"
DEBUG=false  # Set to true only for local development
TESTING=false  # Set to true for test environment

# ====================
# Database (PostgreSQL)
# ====================
# WARNING: Change these credentials in production!
DATABASE_URL=postgresql+asyncpg://storybook:CHANGE_ME@localhost:5432/storybook

# ====================
# Redis
# ====================
REDIS_URL=redis://localhost:6379/0

# ====================
# Celery (Background Tasks)
# ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
USE_CELERY=false  # Set to true in production for async job processing

# ====================
# S3/MinIO Storage
# ====================
# WARNING: Change these credentials in production!
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=storybook
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/storybook

# ====================
# Admin API
# ====================
# Required for admin endpoints (e.g., /health/detailed)
ADMIN_API_KEY=CHANGE_ME

# ====================
# LLM Provider
# ====================
# Options: openai, anthropic, mock
LLM_PROVIDER=mock

# For OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini  # or gpt-4o, gpt-4-turbo

# For Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-anthropic-api-key-here
# LLM_MODEL=claude-3-5-sonnet-20241022

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# ====================
# Image Generation
# ====================
# Options: openai, replicate, fal, mock
IMAGE_PROVIDER=mock

# For Google Gemini (Nano Banana Pro — 아이 얼굴 보존, 권장):
#   사진→캐릭터(from-photo)로 만든 주인공의 원본 사진을 레퍼런스로 넣어
#   모든 페이지에 같은 아이 얼굴을 동화체로 보존한다. 키만 넣으면 자동 동작.
#   단가(2026-06): 1024 ~$0.039/장 (권당 9장 ≈ $0.35).
# IMAGE_PROVIDER=gemini
# IMAGE_API_KEY=your-gemini-api-key-here   # Google AI Studio / Vertex
# IMAGE_MODEL=gemini-3-pro-image-preview

# For OpenAI (DALL-E 3 / GPT Image — 얼굴 보존 미지원):
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=sk-your-openai-api-key-here  # Same key as LLM
# IMAGE_MODEL=dall-e-3  # or gpt-image-1

# For Replicate (SDXL/Flux):
# IMAGE_PROVIDER=replicate
# IMAGE_API_KEY=r8_your-replicate-api-key-here

# For FAL.ai (Flux Schnell):
# IMAGE_PROVIDER=fal
# IMAGE_API_KEY=your-fal-api-key-here

IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3
IMAGE_TIMEOUT=90
IMAGE_MAX_CONCURRENT=3
IMAGE_MAX_RETRIES=3

# ====================
# Audio (TTS/STT) — 낭독·발음
# ====================
# G9: GA에서는 오디오 기능을 명시적으로 비활성으로 출시(원격 config로 전환).
# AUDIO_FEATURE_ENABLED=true로 켜면 /health/ready가 TTS/STT 라이브 구성을 게이트한다.
AUDIO_FEATURE_ENABLED=false

# ====================
# TTS (Text-to-Speech)
# ====================
# Options: google, elevenlabs, mock
# 운영(TESTING=false)에서는 mock/미지정 금지 — readiness가 tts_provider_not_live로 차단(H1).
TTS_PROVIDER=mock

# For Google Cloud TTS:
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=your-google-cloud-api-key-here

# For ElevenLabs:
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default: Rachel voice

GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ====================
# STT (Speech-to-Text) — 발음 평가
# ====================
# Options: openai, google, mock
# 운영에서는 mock/미지정 금지 — readiness가 stt_provider_not_live로 차단(H1).
STT_PROVIDER=mock
# For OpenAI Whisper:
# STT_PROVIDER=openai
# STT_API_KEY=your-openai-api-key-here
STT_API_KEY=
GOOGLE_STT_API_KEY=

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_REQUESTS=10   # Max requests per window
RATE_LIMIT_WINDOW=60     # Window size in seconds

# ====================
# Job Settings
# ====================
JOB_MAX_RETRIES=3
JOB_SLA_SECONDS=600      # 10 minutes max per job

# ====================
# Guardrails
# ====================
DAILY_JOB_LIMIT_PER_USER=20
MAX_PENDING_JOBS=100

# ====================
# CORS (Security)
# ====================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://yourdomain.com
# WARNING: Must be set explicitly in production!
CORS_ORIGINS=http://localhost:3000
