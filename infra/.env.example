# =====================================================
# AI Story Book - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values.
# 변수 이름은 apps/api/src/core/config.py Settings 필드와 1:1 대응한다
# (config는 extra='ignore'이므로 여기 없는 이름을 넣어도 무시된다 — 오타 주의).

# ===================
# Database
# ===================
DB_USER=aistorybook
DB_PASSWORD=change_me_to_secure_password
DB_NAME=aistorybook
# External PostgreSQL: verify-full + mounted provider CA; empty keeps local defaults.
DATABASE_SSL_MODE=
DATABASE_SSL_ROOT_CERT=
# Optional direct PostgreSQL URL for Alembic (same TLS policy).
DATABASE_MIGRATION_URL=

# ===================
# Redis
# ===================
# Default: redis://redis:6379/0 (set in docker-compose)
# 개발 스택(infra/docker-compose.yml)은 127.0.0.1 바인딩이라 기본은 인증 없이 뜬다.
# 값을 주면 그때만 --requirepass 가 켜진다(빈 값으로 두면 인증 없음).
REDIS_PASSWORD=

# ===================
# 개발 스택 호스트 포트 (infra/docker-compose.yml 전용)
# ===================
# 로컬에 네이티브 postgres 가 이미 5432 를 점유 중이면 다른 포트로 바꾼다(예: 5433).
POSTGRES_HOST_PORT=5432

# ===================
# LLM Configuration
# ===================
# Provider: openai, anthropic, gemini, mock
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional: use a private, read-only mounted file instead of the raw key.
# Select infra/docker-compose.provider-key-files.yml and set PROVIDER_KEY_HOST_DIR separately.
# LLM_API_KEY_FILE=/run/asb-provider-keys/openai.key
LLM_API_KEY_FILE=
LLM_MODEL=gpt-5.6-sol
# Live story/image-prompt responses can exceed 30 seconds; avoid unnecessary retries.
LLM_TIMEOUT=90
# Observed provider access only; health checks never send paid AI requests.
PROVIDER_OBSERVATION_TTL_SECONDS=86400
# Optional per-model reference prices; empty mapping reports unknown estimated cost.
PROVIDER_USAGE_PRICES_JSON='{}'
ILLUSTRATION_QUALITY_ENABLED=true

# Enable only after child-data conditions are verified across analysis/images/QA.
# false is intentional; an API key is not provider/ZDR approval.
PHOTO_PROCESSING_ENABLED=false
PHOTO_ANALYSIS_PROVIDER=openai
PHOTO_ANALYSIS_MODEL=gpt-5.6-sol
PHOTO_ANALYSIS_API_KEY=

# ===================
# Image Generation
# ===================
# Provider: openai, gemini, replicate, fal, mock
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
# IMAGE_API_KEY_FILE=/run/asb-provider-keys/openai.key
IMAGE_API_KEY_FILE=
# Validated OpenAI image model for the free beta.
IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_ILLUSTRATION_REPAIR_MODEL=gpt-image-2.6-sunburst
# GPT Image only (generations and edits): low, medium, high, auto.
OPENAI_IMAGE_QUALITY=medium
# Keep the small VM at three until its production capacity is verified.
IMAGE_MAX_CONCURRENT=3

# ===================
# S3 Storage
# ===================
# For MinIO (self-hosted):
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_to_secure_password
S3_BUCKET=ai-story-book
PRIVACY_JOURNAL_ENABLED=false
PRIVACY_JOURNAL_BUCKET=
# Optional second GCS bucket: enable only after fenced backfill, separate
# access/recovery validation, and matching backup configuration are complete.
PRIVACY_JOURNAL_WITNESS_BUCKET=
# Optional dedicated S3 witness: set all five or leave all empty. Mutually
# exclusive with the GCS witness. Use separate S3 credentials. This alone does
# not establish immutability, isolation or restore readiness.
PRIVACY_JOURNAL_WITNESS_S3_ENDPOINT=
PRIVACY_JOURNAL_WITNESS_S3_BUCKET=
PRIVACY_JOURNAL_WITNESS_S3_REGION=
PRIVACY_JOURNAL_WITNESS_S3_ACCESS_KEY=
PRIVACY_JOURNAL_WITNESS_S3_SECRET_KEY=
PRIVACY_JOURNAL_KEY_FILE=
# Optional account media scope; keep this pin and namespace stable across restores.
ACCOUNT_SCOPE_KEY_FILE=
ACCOUNT_SCOPE_KEY_SHA256=
ACCOUNT_SCOPE_NAMESPACE=
# Optional compose override only; absolute host path, never key contents.
ACCOUNT_SCOPE_HOST_KEY_FILE=

# Keep off until the sender, public confirmation link, and reviewer flow are verified.
GUARDIAN_EMAIL_CONSENT_ENABLED=false
GUARDIAN_EMAIL_PUBLIC_ORIGIN=
GUARDIAN_EMAIL_SENDER=
GUARDIAN_EMAIL_SMTP_HOST=
GUARDIAN_EMAIL_SMTP_PORT=465
GUARDIAN_EMAIL_SMTP_SECURITY=implicit_tls
GUARDIAN_EMAIL_SMTP_USERNAME=
# The optional guardian-mail Compose override sets the container path and mounts
# only the host file below into the API. Supply an existing file with mode 0600.
GUARDIAN_EMAIL_SMTP_PASSWORD_FILE=
GUARDIAN_EMAIL_SMTP_HOST_PASSWORD_FILE=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
# Set false for a pre-created private external bucket.
S3_AUTO_CREATE_BUCKET=true

# For AWS S3:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# For Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ===================
# Audio: TTS (Text-to-Speech)
# ===================
# Limited-beta narration only. Verify project ZDR and physical-device playback before launch.
AUDIO_FEATURE_ENABLED=true
AUDIO_NARRATION_ONLY_ENABLED=true
TTS_PROVIDER=openai_realtime
# Google Cloud TTS
# GOOGLE_TTS_API_KEY=your-google-tts-api-key
# Gemini TTS is retained for isolated fictional QA, not child-facing releases.
# It uses application default credentials and an explicitly scoped project.
# GOOGLE_GEMINI_TTS_PROJECT=your-google-cloud-project
# Gemini TTS requires both positive request limits; 0 blocks paid calls.
GOOGLE_GEMINI_TTS_DAILY_REQUEST_LIMIT=0
GOOGLE_GEMINI_TTS_MONTHLY_REQUEST_LIMIT=0
# ElevenLabs
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ===================
# Audio: STT (Speech-to-Text) — 발음 연습
# ===================
# Provider: openai, google (mock 기본값 금지)
STT_PROVIDER=openai
# STT_API_KEY=your-openai-stt-key
# GOOGLE_STT_API_KEY=your-google-stt-key

# ===================
# POD (실물 인쇄 주문 — Printful)
# ===================
POD_MODE=local
POD_PROVIDER=printful
# PRINTFUL_API_KEY=your-printful-api-key
# PRINTFUL_STORE_ID=
# PRINTFUL_SYNC_VARIANT_ID=
# PRINTFUL_BASE_URL=https://api.printful.com

# ===================
# IAP (인앱결제 영수증 검증) — 운영 필수
# ===================
# strict: 영수증 검증 실패 시 fail-closed (운영 필수값)
IAP_VERIFICATION_MODE=strict
# Free limited beta until account recovery and live store purchases are verified.
PURCHASES_ENABLED=false
# 웹훅 서명 시크릿 (App Store/Play 서버 알림 HMAC 검증) — 필수
IAP_WEBHOOK_SECRET=
# Apple (App Store Connect > 앱 내 구입 > 공유 비밀)
APPLE_IAP_SHARED_SECRET=
APPLE_BUNDLE_ID=com.storybook.aiStoryBook
# Google Play (서비스 계정 자격증명 중 택1)
GOOGLE_PLAY_PACKAGE_NAME=com.storybook.ai_story_book
GOOGLE_PLAY_ACCESS_TOKEN=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# ===================
# Application
# ===================
# Public HTTPS API origin, used by deploy health and smoke checks (no trailing slash).
PROD_API_URL=
# Operator and mobile build URLs. These are not passed into the backend containers.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
# 레이트 리밋: 생성·수정 10회, 상태조회·읽기 120회 / 60초 (각각 독립된 한도)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_READ_REQUESTS=120 # Status polling and read-only navigation; writes stay separately limited
RATE_LIMIT_WINDOW=60
# Initial limited beta: total generation requests per Korea-local day, across all users.
# This limits attempts, not currency spend. Configure provider billing limits separately.
DAILY_GENERATION_BUDGET=20
GENERATION_BUDGET_STORE=redis

# Celery 워커 사용 (운영 true — 비동기 생성 파이프라인)
USE_CELERY=true

# 관리 API 인증 키 (/v1/credits/add — 운영 필수, config: admin_api_key)
ADMIN_API_KEY=

# 공유 링크 베이스 URL (config: share_base_url), 예: https://aistorybook.com
SHARE_BASE_URL=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Private media: keep bucket/CDN anonymous reads disabled. DB references stay stable.
# This must be an S3 API endpoint reachable by devices (including emulators).
# Leave empty only if S3_ENDPOINT itself is reachable by devices.
S3_DOWNLOAD_ENDPOINT=
S3_DOWNLOAD_TTL_SECONDS=3600
# Enable only after real order/payment/fulfillment validation (POD_MODE=strict).
POD_ORDERING_ENABLED=false

# Canonical object reference base; changing it requires retaining the old base below.
S3_PUBLIC_URL=http://localhost:9000/ai-story-book
S3_LEGACY_PUBLIC_URLS=

# Choose one OpenAI narration credential source. The file uses the read-only key override.
OPENAI_TTS_API_KEY=
OPENAI_TTS_API_KEY_FILE=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Store signed notifications (inactive until configured).
APPLE_APP_ID=0
APPLE_NOTIFICATION_ENVIRONMENT=Production
APPLE_ROOT_CA_PATHS=
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=
STT_MODEL=whisper-1

# New AI work admission; existing reads/recovery/deletion remain available.
GENERATION_ACCESS_MODE=invite_only
FREE_PLAN_FIRST_BOOK_TRIAL=true
GENERATION_ALLOWED_USER_HASHES=
