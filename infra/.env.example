# =====================================================
# AI Story Book - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values.
# 변수 이름은 apps/api/src/core/config.py Settings 필드와 1:1 대응한다
# (config는 extra='ignore'이므로 여기 없는 이름을 넣어도 무시된다 — 오타 주의).

# ===================
# Database
# ===================
DB_USER=aistorybook
DB_PASSWORD=change_me_to_secure_password
DB_NAME=aistorybook

# ===================
# Redis
# ===================
# Default: redis://redis:6379/0 (set in docker-compose)
# 개발 스택(infra/docker-compose.yml)은 127.0.0.1 바인딩이라 기본은 인증 없이 뜬다.
# 값을 주면 그때만 --requirepass 가 켜진다(빈 값으로 두면 인증 없음).
REDIS_PASSWORD=

# ===================
# 개발 스택 호스트 포트 (infra/docker-compose.yml 전용)
# ===================
# 로컬에 네이티브 postgres 가 이미 5432 를 점유 중이면 다른 포트로 바꾼다(예: 5433).
POSTGRES_HOST_PORT=5432

# ===================
# LLM Configuration
# ===================
# Provider: openai, anthropic, mock
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o

# ===================
# Image Generation
# ===================
# Provider: openai, gemini, replicate, fal, mock
IMAGE_PROVIDER=replicate
IMAGE_API_KEY=r8_your-api-key-here
# Model — provider별로 다름. openai는 dall-e-3(기본값). gemini 사용 시 반드시 지정
# (미지정 시 dall-e-3 모델명으로 gemini URL을 호출해 이미지 단계가 전량 실패):
# IMAGE_MODEL=gemini-3-pro-image-preview

# ===================
# S3 Storage
# ===================
# For MinIO (self-hosted):
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_to_secure_password
S3_BUCKET=ai-story-book
S3_REGION=us-east-1

# For AWS S3:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# For Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ===================
# Audio: TTS (Text-to-Speech)
# ===================
# GA에서 오디오는 기본 비활성. 켜려면 AUDIO_FEATURE_ENABLED=true + 라이브 provider.
# AUDIO_FEATURE_ENABLED=false
# Provider: google, elevenlabs (mock 기본값 금지 — 무음 오디오 배포 방지)
TTS_PROVIDER=google
# Google Cloud TTS
# GOOGLE_TTS_API_KEY=your-google-tts-api-key
# ElevenLabs
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ===================
# Audio: STT (Speech-to-Text) — 발음 연습
# ===================
# Provider: openai, google (mock 기본값 금지)
STT_PROVIDER=openai
# STT_API_KEY=your-openai-stt-key
# GOOGLE_STT_API_KEY=your-google-stt-key

# ===================
# POD (실물 인쇄 주문 — Printful)
# ===================
POD_MODE=local
POD_PROVIDER=printful
# PRINTFUL_API_KEY=your-printful-api-key
# PRINTFUL_STORE_ID=
# PRINTFUL_SYNC_VARIANT_ID=
# PRINTFUL_BASE_URL=https://api.printful.com

# ===================
# IAP (인앱결제 영수증 검증) — 운영 필수
# ===================
# strict: 영수증 검증 실패 시 fail-closed (운영 필수값)
IAP_VERIFICATION_MODE=strict
# 웹훅 서명 시크릿 (App Store/Play 서버 알림 HMAC 검증) — 필수
IAP_WEBHOOK_SECRET=
# Apple (App Store Connect > 앱 내 구입 > 공유 비밀)
APPLE_IAP_SHARED_SECRET=
# Google Play (서비스 계정 자격증명 중 택1)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_ACCESS_TOKEN=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# ===================
# Application
# ===================
# 레이트 리밋 (config: rate_limit_requests / rate_limit_window)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Celery 워커 사용 (운영 true — 비동기 생성 파이프라인)
USE_CELERY=true

# 관리 API 인증 키 (/v1/credits/add — 운영 필수, config: admin_api_key)
ADMIN_API_KEY=

# 공유 링크 베이스 URL (config: share_base_url), 예: https://aistorybook.com
SHARE_BASE_URL=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
