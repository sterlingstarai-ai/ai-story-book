# TEMPLATE ONLY: generate with scripts/prepare_render_blueprint.py after verified CI images exist.
# Render compute $42/mo + separate Supabase $25/mo = initial estimate $67/mo; not a bill cap.
# Only create NEW services: existing autoscaling/settings may be retained by Render.
# Add supabase-ca.crt as a Secret File to BOTH API and worker; no secret content belongs here.
previews:
  generation: 'off'
services:
- type: web
  name: __PREFIX__-api
  runtime: image
  plan: 0.5c-512mb
  region: __REGION__
  image:
    url: __API_IMAGE__
    creds:
      fromRegistryCreds:
        name: __REGISTRY_CREDENTIAL__
  numInstances: 1
  autoDeployTrigger: 'off'
  healthCheckPath: /health/ready
  maxShutdownDelaySeconds: 300
  dockerCommand: python -m src.ops.render_entrypoint api
  preDeployCommand: python -m src.ops.render_entrypoint migrate
  envVars:
  - key: DATABASE_URL
    sync: false
  - key: DATABASE_SSL_MODE
    value: verify-full
  - key: DATABASE_SSL_ROOT_CERT
    value: /etc/secrets/supabase-ca.crt
  - key: DATABASE_MIGRATION_URL
    value: ''
  - key: REDIS_URL
    fromService:
      name: __PREFIX__-redis
      type: keyvalue
