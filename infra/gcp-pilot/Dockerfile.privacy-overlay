# Pilot-only overlay: BASE_IMAGE must be a local tag verified against the intended image ID.
# The base supplies the already-running dependencies and bundled fonts.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY --chown=appuser:appuser src/ /app/src/
COPY --chown=appuser:appuser alembic/ /app/alembic/
COPY --chown=appuser:appuser alembic.ini /app/alembic.ini
COPY --chown=appuser:appuser scripts/provision_store_review.py /app/scripts/provision_store_review.py
USER appuser
