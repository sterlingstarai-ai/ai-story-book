{
  admin off
  auto_https off
  # Required deployment setting: only the actual Cloud Run serving peers.
  # Never set this to all addresses or trust the caller's leftmost XFF entry.
  servers {
    trusted_proxies static {$CLOUD_RUN_TRUSTED_PROXY_CIDRS}
    trusted_proxies_strict
    client_ip_headers X-Forwarded-For
  }
  log {
    output discard
  }
}

:8080 {
  @app path /health /health/live /health/ready /v1/* /share/*
  handle @app {
    request_body {
      max_size 17MB
    }
    reverse_proxy https://10.128.0.2:443 {
      header_up Host 35.209.174.246
      # Send the single address verified at the managed ingress.
      header_up X-Forwarded-For {client_ip}
      transport http {
        tls_server_name 35.209.174.246
        import {$ASB_EDGE_TLS_INCLUDE:/etc/caddy/unused-client-auth-*.caddy}
        dial_timeout 5s
        response_header_timeout 125s
      }
    }
  }
  handle {
    respond 404
  }
}
