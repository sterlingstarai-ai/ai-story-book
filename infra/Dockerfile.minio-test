# Disposable integration-test dependency only. Not an approved production image.
# Official release assets are pinned by SHA-256 because the previously pinned
# public Quay image can no longer be pulled anonymously.
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60
ARG TARGETARCH
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
      amd64) checksum=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f ;; \
      arm64) checksum=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d ;; \
      *) echo "Unsupported test architecture" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /usr/local/bin/minio "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-${TARGETARCH}.RELEASE.2025-09-07T16-13-09Z" \
    && echo "$checksum  /usr/local/bin/minio" | sha256sum -c - \
    && chmod 755 /usr/local/bin/minio
ENTRYPOINT ["/usr/local/bin/minio"]
